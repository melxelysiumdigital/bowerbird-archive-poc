# =============================================================================
# Shopify OIDC Proxy — Environment Configuration
# =============================================================================

# --- Proxy Server ---
PORT=3000
# The public URL of this proxy (used as OIDC issuer and in discovery doc)
# In dev: use ngrok URL. In prod: your deployed domain.
PROXY_BASE_URL=https://your-proxy.ngrok-free.app

# --- Entra External ID ---
# Your CIAM tenant's OpenID discovery URL
# Format: https://{tenant}.ciamlogin.com/{tenant-id}/v2.0/.well-known/openid-configuration
ENTRA_DISCOVERY_URL=https://ShopifyExternalPOC.ciamlogin.com/a6967e10-cc01-448b-af96-d0a13086b19e/v2.0/.well-known/openid-configuration

# The Entra app registration's client ID and secret
ENTRA_CLIENT_ID=123xx
ENTRA_CLIENT_SECRET=your-client-secret-here

# --- Signing Keys ---
# Path to the RSA key pair used to sign rewritten JWTs
# Generate with: npm run generate-keys
KEYS_PATH=./keys
