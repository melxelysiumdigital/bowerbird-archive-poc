{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "target": "ES2020",
    "checkJs": true,
    "allowJs": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "noEmit": true,
    "outDir": "dist",
    "skipLibCheck": true
  },
  "include": ["src", "shopify.d.ts"],
  "exclude": ["dist", "node_modules"]
}
